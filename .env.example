# CloudOps AI Agent Configuration

# Operation Mode: "demo" (simulated AWS/GitHub/Docker) or "live"
CLOUDOPS_MODE=demo

# Granular Integration Modes (can be "demo" or "live" individually)
GITHUB_MODE=demo
AWS_MODE=demo
DOCKER_MODE=demo

# LLM Provider: "demo" runs 100% locally with zero AI API keys required!
# Options: demo | anthropic | openai | gemini
LLM_PROVIDER=demo
LLM_MODEL=cloudops-demo-engine

# Provider API Keys (supply the one corresponding to LLM_PROVIDER)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Backend Security
JWT_SECRET_KEY=generate-a-strong-random-key-here-for-production
LOG_LEVEL=INFO

# Database (empty defaults to SQLite for local development; set postgresql+asyncpg for production)
DATABASE_URL=

# Model Context Protocol (MCP) Server URLs
AWS_MCP_URL=http://127.0.0.1:8101/mcp
GITHUB_MCP_URL=http://127.0.0.1:8102/mcp
DOCKER_MCP_URL=http://127.0.0.1:8103/mcp

# Live AWS Configuration (used when CLOUDOPS_MODE=live)
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1
# AWS credentials are auto-discovered from ~/.aws/credentials or IAM instance/task role

# Live GitHub Configuration (used when CLOUDOPS_MODE=live)
GITHUB_REPOSITORY=acme-corp/orders-api
GITHUB_TOKEN=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
